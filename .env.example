# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# --- Product admin: Om Threads admin on the Mac mini (omthreads-admin) ----
# Leave SHOP_API_URL and the Sanity project ID blank to run on the built-in
# sample catalog.
# The Mac mini's public catalog address, e.g. https://<name>.duckdns.org
# (for local development: http://127.0.0.1:8795).
SHOP_API_URL=
# Same value as SHOP_API_TOKEN in the Mac mini's .env.
SHOP_API_TOKEN=
# Same value as REVALIDATE_SECRET in the Mac mini's .env. Lets the admin
# refresh the site so changes appear within seconds.
REVALIDATE_SECRET=

# --- Alternative product admin: Sanity ------------------------------------
# Only used when SHOP_API_URL is blank.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Secret shared with the Sanity webhook (REVALIDATE_SECRET also works).
SANITY_REVALIDATE_SECRET=

# --- Site ---------------------------------------------------------------
# Public URL of the site (used for SEO links). Vercel sets VERCEL_URL
# automatically, so this is only needed once you have a custom domain.
NEXT_PUBLIC_SITE_URL=

# --- Payments (Phase 3) -----------------------------------------------
# "etsy" (default) sends shoppers to Etsy to pay. "stripe" enables direct
# checkout once the Stripe integration is added.
NEXT_PUBLIC_PAYMENT_PROVIDER=etsy

# --- Inbox (contact form + newsletter) ---------------------------------
# With SHOP_API_URL set, messages go to the Mac mini admin's Inbox.
# With Sanity instead: a token with Editor rights (sanity.io/manage → API → Tokens).
SANITY_WRITE_TOKEN=
# Optional email alerts via resend.com (also a backup if the Mac mini is offline)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
